      <bpmn:outgoing>Fluxo_75</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_76</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Avulsas" name="Selecionar fotos avulsas">
