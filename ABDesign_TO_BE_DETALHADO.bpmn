      <bpmn:incoming>Fluxo_84</bpmn:incoming>
      <bpmn:outgoing>Fluxo_90</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Fluxo_70" sourceRef="Inicio_familia" targetRef="Consultar" />
    <bpmn:sequenceFlow id="Fluxo_71" sourceRef="Consultar" targetRef="Comprar" />
    <bpmn:sequenceFlow id="Fluxo_72" name="Sim" sourceRef="Comprar" targetRef="Produto">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">compra desejada</bpmn:conditionExpression>
