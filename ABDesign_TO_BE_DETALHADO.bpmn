    <bpmn:sequenceFlow id="Fluxo_81" sourceRef="Receber_cobranca" targetRef="Pagar" />
    <bpmn:sequenceFlow id="Fluxo_87" name="Sim" sourceRef="Tentar" targetRef="Pagar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">regularização desejada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_82" sourceRef="Pagar" targetRef="Enviar_pagamento" />
