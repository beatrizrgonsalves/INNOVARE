<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definicoes_ABDesign" targetNamespace="https://abdesign.example/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Colaboracao_ABDesign" name="ABDesign — Venda de fotos e kits fotográficos na escola">
    <bpmn:participant id="Participante_Escola" name="Escola / Secretaria" processRef="Processo_Escola" />
    <bpmn:participant id="Participante_ABDesign" name="ABDesign — Fotografia escolar" processRef="Processo_ABDesign" />
    <bpmn:participant id="Participante_Familias" name="Pais / Responsáveis" processRef="Processo_Familias" />
    <bpmn:messageFlow id="Mensagem_1" name="Proposta comercial" sourceRef="Proposta" targetRef="Inicio_escola" />
    <bpmn:messageFlow id="Mensagem_2" name="Aceitação da proposta" sourceRef="Aceitar_escola" targetRef="Resposta" />
    <bpmn:messageFlow id="Mensagem_3" name="Recusa da proposta" sourceRef="Recusar_escola" targetRef="Resposta" />
    <bpmn:messageFlow id="Mensagem_4" name="Contrato e catálogo" sourceRef="Contrato" targetRef="Receber_contrato" />
    <bpmn:messageFlow id="Mensagem_5" name="Contrato assinado" sourceRef="Devolver" targetRef="Assinado" />
    <bpmn:messageFlow id="Mensagem_6" name="Data sugerida" sourceRef="Agendar" targetRef="Data" />
    <bpmn:messageFlow id="Mensagem_7" name="Confirmação e autorizações" sourceRef="Confirmar_escola" targetRef="Pronta" />
    <bpmn:messageFlow id="Mensagem_8" name="Acesso à galeria" sourceRef="Avisar" targetRef="Inicio_familia" />
    <bpmn:messageFlow id="Mensagem_9" name="Desistência" sourceRef="Nao_comprar" targetRef="Desistencia" />
    <bpmn:messageFlow id="Mensagem_10" name="Pedido de fotos ou kit" sourceRef="Enviar_pedido" targetRef="Pedido" />
    <bpmn:messageFlow id="Mensagem_11" name="Cobrança" sourceRef="Cobranca" targetRef="Receber_cobranca" />
    <bpmn:messageFlow id="Mensagem_12" name="Informação de pagamento" sourceRef="Enviar_pagamento" targetRef="Pagamento" />
    <bpmn:messageFlow id="Mensagem_13" name="Pagamento pendente" sourceRef="Pendente" targetRef="Status_pendente" />
    <bpmn:messageFlow id="Mensagem_14" name="Pagamento confirmado" sourceRef="Aprovacao" targetRef="Status_ok" />
    <bpmn:messageFlow id="Mensagem_15" name="Cancelamento" sourceRef="Cancelar_familia" targetRef="Cancelar" />
    <bpmn:messageFlow id="Mensagem_16" name="Pedidos produzidos" sourceRef="Entregar" targetRef="Receber_escola" />
    <bpmn:messageFlow id="Mensagem_17" name="Fotos e kits" sourceRef="Distribuir" targetRef="Receber_fotos" />
    <bpmn:messageFlow id="Mensagem_18" name="Confirmação de recebimento" sourceRef="Confirmar_familia" targetRef="Recibo" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_Escola" name="Escola / Secretaria" isExecutable="false">
    <bpmn:documentation>Modelo descritivo de colaboração. Representa uma parceria escolar e uma venda de fotos avulsas ou de um kit. Para várias famílias, repetir a instância de venda por pedido. As avaliações são realizadas nas tarefas anteriores aos gateways. Não define valores, prazos ou regras comerciais não informados.</bpmn:documentation>
    <bpmn:userTask id="Avaliar_escola" name="Avaliar proposta e catálogo">
      <bpmn:incoming>Fluxo_55</bpmn:incoming>
      <bpmn:outgoing>Fluxo_56</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Devolver" name="Devolver contrato assinado">
      <bpmn:incoming>Fluxo_62</bpmn:incoming>
      <bpmn:outgoing>Fluxo_63</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Data" name="Receber proposta de data">
      <bpmn:incoming>Fluxo_63</bpmn:incoming>
      <bpmn:outgoing>Fluxo_64</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Comunicar" name="Confirmar data e orientar famílias">
      <bpmn:incoming>Fluxo_64</bpmn:incoming>
      <bpmn:outgoing>Fluxo_65</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Autorizar" name="Reunir autorizações e organizar alunos">
      <bpmn:incoming>Fluxo_65</bpmn:incoming>
      <bpmn:outgoing>Fluxo_66</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Confirmar_escola" name="Enviar confirmação e autorizações">
      <bpmn:incoming>Fluxo_66</bpmn:incoming>
      <bpmn:outgoing>Fluxo_67</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Receber_escola" name="Receber pedidos identificados">
      <bpmn:incoming>Fluxo_67</bpmn:incoming>
      <bpmn:outgoing>Fluxo_68</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Distribuir" name="Distribuir fotos e kits às famílias">
      <bpmn:incoming>Fluxo_68</bpmn:incoming>
      <bpmn:outgoing>Fluxo_69</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Fim_escola" name="Distribuição concluída">
      <bpmn:incoming>Fluxo_69</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Decidir_escola" name="Aceitar parceria?" gatewayDirection="Diverging" default="Fluxo_58">
      <bpmn:incoming>Fluxo_56</bpmn:incoming>
      <bpmn:outgoing>Fluxo_57</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_58</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fim_escola_recusa" name="Proposta recusada">
      <bpmn:incoming>Fluxo_59</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Aceitar_escola" name="Informar aceitação">
      <bpmn:incoming>Fluxo_57</bpmn:incoming>
      <bpmn:outgoing>Fluxo_60</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Assinar_escola" name="Definir produtos e assinar contrato">
      <bpmn:incoming>Fluxo_61</bpmn:incoming>
      <bpmn:outgoing>Fluxo_62</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="Receber_contrato" name="Receber contrato e catálogo">
      <bpmn:incoming>Fluxo_60</bpmn:incoming>
      <bpmn:outgoing>Fluxo_61</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Recusar_escola" name="Informar recusa">
      <bpmn:incoming>Fluxo_58</bpmn:incoming>
      <bpmn:outgoing>Fluxo_59</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="Inicio_escola" name="Proposta recebida">
      <bpmn:outgoing>Fluxo_55</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Evento_proposta" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Fluxo_55" sourceRef="Inicio_escola" targetRef="Avaliar_escola" />
    <bpmn:sequenceFlow id="Fluxo_56" sourceRef="Avaliar_escola" targetRef="Decidir_escola" />
    <bpmn:sequenceFlow id="Fluxo_62" sourceRef="Assinar_escola" targetRef="Devolver" />
    <bpmn:sequenceFlow id="Fluxo_63" sourceRef="Devolver" targetRef="Data" />
    <bpmn:sequenceFlow id="Fluxo_64" sourceRef="Data" targetRef="Comunicar" />
    <bpmn:sequenceFlow id="Fluxo_65" sourceRef="Comunicar" targetRef="Autorizar" />
    <bpmn:sequenceFlow id="Fluxo_66" sourceRef="Autorizar" targetRef="Confirmar_escola" />
    <bpmn:sequenceFlow id="Fluxo_67" sourceRef="Confirmar_escola" targetRef="Receber_escola" />
    <bpmn:sequenceFlow id="Fluxo_68" sourceRef="Receber_escola" targetRef="Distribuir" />
    <bpmn:sequenceFlow id="Fluxo_69" sourceRef="Distribuir" targetRef="Fim_escola" />
    <bpmn:sequenceFlow id="Fluxo_57" name="Sim" sourceRef="Decidir_escola" targetRef="Aceitar_escola">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">parceria aceita</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_58" name="Não" sourceRef="Decidir_escola" targetRef="Recusar_escola" />
    <bpmn:sequenceFlow id="Fluxo_59" sourceRef="Recusar_escola" targetRef="Fim_escola_recusa" />
    <bpmn:sequenceFlow id="Fluxo_60" sourceRef="Aceitar_escola" targetRef="Receber_contrato" />
    <bpmn:sequenceFlow id="Fluxo_61" sourceRef="Receber_contrato" targetRef="Assinar_escola" />
  </bpmn:process>
  <bpmn:process id="Processo_ABDesign" name="ABDesign — Fotografia escolar" isExecutable="false">
    <bpmn:documentation>Modelo descritivo de colaboração. Representa uma parceria escolar e uma venda de fotos avulsas ou de um kit. Para várias famílias, repetir a instância de venda por pedido. As avaliações são realizadas nas tarefas anteriores aos gateways. Não define valores, prazos ou regras comerciais não informados.</bpmn:documentation>
    <bpmn:laneSet id="Raias_ABDesign">
      <bpmn:lane id="Raia_Entrega" name="Conferência / Entrega">
        <bpmn:flowNodeRef>Entrega_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Organizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Entregar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recibo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Encerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_AB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Conferir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_Producao" name="Produção / Gráfica">
        <bpmn:flowNodeRef>Producao_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Avaliar_producao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reimprimir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imprimir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Corrigir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_Financeiro" name="Site / Financeiro">
        <bpmn:flowNodeRef>Avisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aguardar_pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Desistencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_sem_venda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cobranca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aguardar_pagamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pagamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Liberar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pendente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancelar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_cancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aprovacao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_Edicao" name="Edição / Diagramação">
        <bpmn:flowNodeRef>Catalogo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imagens_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Editar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Avaliar_imagens</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Arquivos</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_Fotografia" name="Equipe de fotografia">
        <bpmn:flowNodeRef>Preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Refazer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fotografar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Avaliar_fotos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fotos_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_Comercial" name="Comercial / Atendimento">
        <bpmn:flowNodeRef>Fim_recusa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Assinado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Agendar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pronta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aceita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Resposta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inicio_AB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Buscar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proposta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="Fim_recusa" name="Parceria não firmada">
      <bpmn:incoming>Fluxo_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Assinado" name="Receber contrato assinado">
      <bpmn:incoming>Fluxo_7</bpmn:incoming>
      <bpmn:outgoing>Fluxo_8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Agendar" name="Propor data da sessão">
      <bpmn:incoming>Fluxo_8</bpmn:incoming>
      <bpmn:outgoing>Fluxo_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Pronta" name="Receber confirmação e autorizações">
      <bpmn:incoming>Fluxo_9</bpmn:incoming>
      <bpmn:outgoing>Fluxo_10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:manualTask id="Preparar" name="Preparar equipe e materiais">
      <bpmn:incoming>Fluxo_10</bpmn:incoming>
      <bpmn:outgoing>Fluxo_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Catalogo" name="Preparar modelos de fotos e kits">
      <bpmn:incoming>Fluxo_19</bpmn:incoming>
      <bpmn:outgoing>Fluxo_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Avisar" name="Enviar acesso e orientações">
      <bpmn:incoming>Fluxo_23</bpmn:incoming>
      <bpmn:outgoing>Fluxo_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Aguardar_pedido">
      <bpmn:incoming>Fluxo_24</bpmn:incoming>
      <bpmn:outgoing>Fluxo_25</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_26</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="Pedido" name="Receber pedido e dados do aluno">
      <bpmn:incoming>Fluxo_25</bpmn:incoming>
      <bpmn:outgoing>Fluxo_28</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Desistencia" name="Receber desistência da compra">
      <bpmn:incoming>Fluxo_26</bpmn:incoming>
      <bpmn:outgoing>Fluxo_27</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Fim_sem_venda" name="Venda não realizada">
      <bpmn:incoming>Fluxo_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Registrar" name="Registrar pedido e calcular total">
      <bpmn:incoming>Fluxo_28</bpmn:incoming>
      <bpmn:outgoing>Fluxo_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Cobranca" name="Enviar cobrança do pedido">
      <bpmn:incoming>Fluxo_29</bpmn:incoming>
      <bpmn:outgoing>Fluxo_30</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Aguardar_pagamento">
      <bpmn:incoming>Fluxo_30</bpmn:incoming>
      <bpmn:incoming>Fluxo_38</bpmn:incoming>
      <bpmn:outgoing>Fluxo_31</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_32</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="Pagamento" name="Receber informação de pagamento">
      <bpmn:incoming>Fluxo_31</bpmn:incoming>
      <bpmn:outgoing>Fluxo_34</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Verificar" name="Verificar recebimento do pagamento">
      <bpmn:incoming>Fluxo_34</bpmn:incoming>
      <bpmn:outgoing>Fluxo_35</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Pago" name="Pagamento confirmado?" gatewayDirection="Diverging" default="Fluxo_37">
      <bpmn:incoming>Fluxo_35</bpmn:incoming>
      <bpmn:outgoing>Fluxo_36</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Liberar" name="Liberar pedido para produção">
      <bpmn:incoming>Fluxo_36</bpmn:incoming>
      <bpmn:outgoing>Fluxo_39</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Entrega_ok" name="Pedido completo e correto?" gatewayDirection="Diverging" default="Fluxo_49">
      <bpmn:incoming>Fluxo_47</bpmn:incoming>
      <bpmn:outgoing>Fluxo_48</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Organizar" name="Identificar e embalar por aluno">
      <bpmn:incoming>Fluxo_48</bpmn:incoming>
      <bpmn:outgoing>Fluxo_51</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="Entregar" name="Entregar pedidos à escola">
      <bpmn:incoming>Fluxo_51</bpmn:incoming>
      <bpmn:outgoing>Fluxo_52</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Recibo" name="Receber confirmação da família">
      <bpmn:incoming>Fluxo_52</bpmn:incoming>
      <bpmn:outgoing>Fluxo_53</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Encerrar" name="Concluir pedido e registrar entrega">
      <bpmn:incoming>Fluxo_53</bpmn:incoming>
      <bpmn:outgoing>Fluxo_54</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Fim_AB" name="Pedido concluído">
      <bpmn:incoming>Fluxo_54</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Contrato" name="Enviar contrato e catálogo">
      <bpmn:incoming>Fluxo_5</bpmn:incoming>
      <bpmn:outgoing>Fluxo_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Aceita" name="Proposta aceita?" gatewayDirection="Diverging" default="Fluxo_6">
      <bpmn:incoming>Fluxo_4</bpmn:incoming>
      <bpmn:outgoing>Fluxo_5</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="Resposta" name="Receber resposta da escola">
      <bpmn:incoming>Fluxo_3</bpmn:incoming>
      <bpmn:outgoing>Fluxo_4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:startEvent id="Inicio_AB" name="Prospecção iniciada">
      <bpmn:outgoing>Fluxo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Buscar" name="Buscar escolas parceiras">
      <bpmn:incoming>Fluxo_1</bpmn:incoming>
      <bpmn:outgoing>Fluxo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Proposta" name="Enviar proposta de fotos e kits">
      <bpmn:incoming>Fluxo_2</bpmn:incoming>
      <bpmn:outgoing>Fluxo_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="Refazer" name="Refazer fotos pendentes">
      <bpmn:incoming>Fluxo_15</bpmn:incoming>
      <bpmn:outgoing>Fluxo_16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Fotografar" name="Realizar sessão fotográfica">
      <bpmn:incoming>Fluxo_11</bpmn:incoming>
      <bpmn:incoming>Fluxo_16</bpmn:incoming>
      <bpmn:outgoing>Fluxo_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Avaliar_fotos" name="Conferir cobertura e qualidade">
      <bpmn:incoming>Fluxo_12</bpmn:incoming>
      <bpmn:outgoing>Fluxo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Fotos_ok" name="Fotos completas e adequadas?" gatewayDirection="Diverging" default="Fluxo_15">
      <bpmn:incoming>Fluxo_13</bpmn:incoming>
      <bpmn:outgoing>Fluxo_14</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Imagens_ok" name="Imagens aprovadas?" gatewayDirection="Diverging" default="Fluxo_20">
