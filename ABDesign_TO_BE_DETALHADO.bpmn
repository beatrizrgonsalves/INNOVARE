      <bpmn:incoming>Fluxo_71</bpmn:incoming>
      <bpmn:outgoing>Fluxo_72</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_73</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Nao_comprar" name="Informar desistência">
